<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>at365.Shell</RootNamespace>
    <StartupObject>at365.App</StartupObject>
    <Copyright>at365</Copyright>
    <ApplicationIcon>Resources\Watch.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishDir>$(MSBuildProjectDirectory)\publish\</PublishDir>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <AssemblyName>Watch.at365</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- LegacyUserSettings is the read-only migration type; do not compile the old generated duplicate. -->
    <Compile Remove="Properties\Settings.Designer.cs" />
    <None Remove="Hatten.ttf" />
    <None Remove="Resources\Off.ico" />
    <None Remove="Resources\On.ico" />
    <None Remove="Resources\Watch.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Hatten.ttf" />
    <Resource Include="Resources\Off.ico" />
    <Resource Include="Resources\On.ico" />
    <Resource Include="Resources\Watch.ico" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Watch.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
