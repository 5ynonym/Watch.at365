<Window x:Class="at365.Clipboard365.ClipboardHistoryWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="クリップボード履歴"
        Width="520"
        SizeToContent="Height"
        MaxHeight="640"
        MinHeight="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="OnPreviewKeyDown"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ScrollPage"
               TargetType="RepeatButton">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width"
                    Value="8"/>
            <Setter Property="MinWidth"
                    Value="8"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Orientation="Vertical"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip"
                                                        Background="#999999"
                                                        CornerRadius="3"
                                                        Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="Grip"
                                                                Property="Background"
                                                                Value="#555555"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging"
                                                             Value="True">
                                                        <Setter TargetName="Grip"
                                                                Property="Background"
                                                                Value="#333333"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F3F3F3"
            BorderBrush="DarkGray"
            BorderThickness="1"
            CornerRadius="5"
            Padding="10,10,5,10">
        <ListBox x:Name="HistoryList"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 AlternationCount="2147483647"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 PreviewMouseLeftButtonUp="OnItemClick">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="PART_ScrollViewer"
                                  Focusable="False"
                                  Padding="0"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                    <Setter Property="Height"
                            Value="76"/>
                    <Setter Property="Padding"
                            Value="10,6"/>
                    <Setter Property="Margin"
                            Value="0,6,4,0"/>
                    <Setter Property="FocusVisualStyle"
                            Value="{x:Null}"/>
                    <Setter Property="ToolTip"
                            Value="{Binding ToolTipText}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card"
                                        Background="#FCFCFC"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Stretch"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Card"
                                                Property="Background"
                                                Value="#FFFFFF"/>
                                        <Setter TargetName="Card"
                                                Property="BorderBrush"
                                                Value="#AAAAAA"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter TargetName="Card"
                                                Property="BorderBrush"
                                                Value="DarkGray"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex"
                                 Value="0">
                            <Setter Property="Margin"
                                    Value="0,0,4,0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button Content="×"
                                DockPanel.Dock="Left"
                                Width="22"
                                Height="22"
                                Margin="0,0,6,0"
                                VerticalAlignment="Top"
                                Focusable="False"
                                Click="OnDeleteClick"
                                ToolTip="履歴から削除"
                                AutomationProperties.Name="履歴から削除">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="DeleteBackground"
                                            Background="Transparent"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="DeleteBackground"
                                                    Property="Background"
                                                    Value="#E5E5E5"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter TargetName="DeleteBackground"
                                                    Property="Background"
                                                    Value="#CCCCCC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Image Source="{Binding Image}"
                               MaxWidth="110"
                               Height="56"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               DockPanel.Dock="Left">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Margin"
                                            Value="0,0,8,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Image}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding PreviewText}"
                                   FontSize="14"
                                   LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap"
                                   MaxHeight="54"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</Window>
