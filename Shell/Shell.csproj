<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>at365.Shell</RootNamespace>
    <StartupObject>at365.App</StartupObject>
    <Copyright>at365</Copyright>
    <ApplicationIcon>Resources\Watch.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <AssemblyName>Watch.at365</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Common\**" />
    <Compile Remove="Modules\**" />
    <EmbeddedResource Remove="Common\**" />
    <EmbeddedResource Remove="Modules\**" />
    <None Remove="Common\**" />
    <None Remove="Modules\**" />
    <Page Remove="Common\**" />
    <Page Remove="Modules\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Off.ico" />
    <None Remove="Resources\On.ico" />
    <None Remove="Resources\Watch.ico" />
  </ItemGroup>



  <ItemGroup>
    <Resource Include="Resources\Off.ico" />
    <Resource Include="Resources\On.ico" />
    <Resource Include="Resources\Watch.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clipboard\Clipboard.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Gesture\Gesture.csproj" />
    <ProjectReference Include="..\Native\Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="Hatten.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Watch.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>